{
  "name": "sierra-command-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute sierra-command-db --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute sierra-command-db --remote --file=./schema.sql"
  },
  "devDependencies": {
    "vitest": "^2.1.9",
    "wrangler": "^4.130.0"
  }
}
